{
  "name": "MyDISK",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.3",
      "@orpc/client": "^1.15.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/ && tsc -b packages/api",
    "dev:types": "tsc -b packages/api --watch",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @MyDISK/db --",
    "db:studio": "turbo run db:studio -F @MyDISK/db --",
    "db:generate": "turbo run db:generate -F @MyDISK/db --",
    "db:migrate": "turbo run db:migrate -F @MyDISK/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write",
    "cli": "bun run packages/cli/src/index.ts",
    "setup": "bun run packages/cli/src/index.ts install",
    "openapi": "bun run packages/cli/src/index.ts openapi"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@MyDISK/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.7",
    "@solidjs/compiler": "2.0.0-rc.7",
    "@solidjs/signals": "2.0.0-rc.7"
  },
  "packageManager": "bun@1.3.14"
}
