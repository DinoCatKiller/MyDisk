{
  "name": "@MyDISK/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "ali-oss": "^6.23.0",
    "cos-nodejs-sdk-v5": "^2.14.8"
  },
  "devDependencies": {
    "@MyDISK/config": "workspace:*",
    "@types/ali-oss": "^6.16.11",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
