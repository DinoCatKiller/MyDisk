# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @public @dynamic @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Redis：BullMQ 队列与缓存
# @type=string
REDIS_URL=redis://127.0.0.1:6379

# 本地存储根目录（相对路径基于项目根解析）
# @type=string
STORAGE_ROOT=storage

# 分片上传单片大小（字节），默认 8MB
# @type=number
UPLOAD_CHUNK_SIZE=8388608

# 用于加密存储密钥与 SMTP 密码，生产环境务必更换为随机值
# @type=string(minLength=32)
ENCRYPTION_KEY=my-disk-dev-only-encryption-key-01

# 是否开放 /api-reference 与 /openapi.json
# @public @type=boolean
API_REFERENCE_ENABLED=true

# 是否开启 WebDAV（P4 接入）
# @public @type=boolean
WEBDAV_ENABLED=true
