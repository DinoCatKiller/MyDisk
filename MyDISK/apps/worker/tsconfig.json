{
  "references": [{ "path": "../../packages/queue" }, { "path": "../../packages/db" }],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
