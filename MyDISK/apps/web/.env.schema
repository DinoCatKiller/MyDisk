# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Redis：BullMQ 队列与缓存
# @type=string
REDIS_URL=redis://127.0.0.1:6379

# 监听端口：页面路由与 `/api` 子系统同源单端口
# 非密钥，但其字面值（如 "3000"）会合法出现在响应里（字节数、时间戳等），
# 与 STORAGE_ROOT 同理关闭响应泄漏拦截（防止 `patch-response.mjs` 误报）。
# @sensitive={preventLeaks=false} @type=number
PORT=3000

# 监听地址：默认全网卡（容器 / 局域网）；仅本机访问可写 127.0.0.1
# @sensitive={preventLeaks=false} @type=string
HOST=0.0.0.0

# 本地存储根目录（相对路径基于项目根解析）
# 非密钥，且其字面值（如 "storage"）会合法出现在 /api/openapi.json 等响应里，
# 故显式关闭响应泄漏拦截（preventLeaks），日志脱敏仍然生效。
# @sensitive={preventLeaks=false} @type=string
STORAGE_ROOT=storage

# 分片上传单片大小（字节），默认 8MB
# @type=number
UPLOAD_CHUNK_SIZE=8388608

# 用于加密存储密钥与 SMTP 密码，生产环境务必更换为随机值
# @type=string(minLength=32)
ENCRYPTION_KEY=my-disk-dev-only-encryption-key-01

# 是否开放 /api/reference 与 /api/openapi.json
# @public @type=boolean
API_REFERENCE_ENABLED=true

# 是否开启 WebDAV（P4 接入）
# @public @type=boolean
WEBDAV_ENABLED=true
